function connect_chubbys() (
    local SCAN_SECONDS=30

    log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
    warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*"; }
    die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

    # --- 0. Check arguments and tools ---------------------------------------
    [[ $# -eq 1 ]] || die "Usage: ${FUNCNAME[0]} <MAC address>   e.g. ${FUNCNAME[0]} AA:BB:CC:DD:EE:FF"
    local MAC="${1^^}"
    [[ "$MAC" =~ ^([0-9A-F]{2}:){5}[0-9A-F]{2}$ ]] || die "Invalid MAC address: $1"
    command -v bluetoothctl >/dev/null || die "bluetoothctl not found. Install with: sudo apt install bluez"

    # --- 1. Make sure the adapter is up -------------------------------------
    log "Powering on Bluetooth adapter"
    rfkill unblock bluetooth 2>/dev/null || true
    bluetoothctl power on >/dev/null || die "Could not power on the Bluetooth adapter"

    # --- 2. Forget the device -----------------------------------------------
    log "Forgetting device $MAC"
    bluetoothctl disconnect "$MAC" >/dev/null 2>&1 || true
    bluetoothctl remove "$MAC"     >/dev/null 2>&1 || true
    sleep 2

    # --- 3. Scan until the device shows up again ----------------------------
    log "Scanning for up to ${SCAN_SECONDS}s — make sure the Chubby Buttons are in pairing mode"
    timeout "$SCAN_SECONDS" bluetoothctl --timeout "$SCAN_SECONDS" scan on >/dev/null 2>&1 &
    local SCAN_PID=$!
    trap 'kill "$SCAN_PID" 2>/dev/null; bluetoothctl scan off >/dev/null 2>&1' EXIT

    local found="" i
    for ((i = 0; i < SCAN_SECONDS; i++)); do
        if bluetoothctl devices 2>/dev/null | grep -qi -- "$MAC"; then
            found=1
            break
        fi
        sleep 1
    done

    kill "$SCAN_PID" 2>/dev/null
    bluetoothctl scan off >/dev/null 2>&1
    trap - EXIT

    [[ -n "$found" ]] || die "Device $MAC not found. Put the Chubby Buttons in pairing mode and run again."
    log "Found $MAC"

    # --- 4. Pair, trust, connect --------------------------------------------
    log "Pairing"
    if ! bluetoothctl pair "$MAC" 2>&1 | tee /dev/stderr | grep -qiE "Pairing successful|AlreadyExists"; then
        warn "Pairing did not report success; continuing anyway"
    fi

    log "Trusting"
    bluetoothctl trust "$MAC" >/dev/null || warn "Trust command failed"

    log "Connecting"
    local attempt
    for attempt in 1 2 3; do
        if bluetoothctl connect "$MAC" 2>&1 | grep -qi "Connection successful"; then
            log "Connected to Chubby Buttons ($MAC)"
            exit 0
        fi
        warn "Connect attempt $attempt failed, retrying..."
        sleep 3
    done

    die "Could not connect. Try: bluetoothctl info $MAC"
)