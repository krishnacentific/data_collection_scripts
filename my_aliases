function connect_chubbys() (
    local SCAN_SECONDS=30

    log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
    ok()   { printf '\033[1;32m[✓]\033[0m %s\n' "$*"; }
    warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*"; }
    die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

    # --- 0. Check arguments and tools ---------------------------------------
    [[ $# -ge 1 ]] || die "Usage: ${FUNCNAME[0]} <MAC> [MAC ...]   e.g. ${FUNCNAME[0]} AA:BB:CC:DD:EE:01 AA:BB:CC:DD:EE:02"
    local -a remaining=()
    local arg MAC
    for arg in "$@"; do
        MAC="${arg^^}"
        [[ "$MAC" =~ ^([0-9A-F]{2}:){5}[0-9A-F]{2}$ ]] || die "Invalid MAC address: $arg"
        remaining+=("$MAC")
    done
    command -v bluetoothctl >/dev/null || die "bluetoothctl not found. Install with: sudo apt install bluez"

    # --- 1. Make sure the adapter is up -------------------------------------
    log "Powering on Bluetooth adapter"
    # rfkill unblock bluetooth 2>/dev/null || true
    bluetoothctl power on >/dev/null || die "Could not power on the Bluetooth adapter"

    # --- 2. Forget every device on the list ---------------------------------
    for MAC in "${remaining[@]}"; do
        log "Forgetting device $MAC"
        bluetoothctl disconnect "$MAC" >/dev/null 2>&1 || true
        bluetoothctl remove "$MAC"     >/dev/null 2>&1 || true
    done
    sleep 2

    # Scan until any MAC still in "remaining" shows up; print the one found.
    scan_for_any() {
        timeout "$SCAN_SECONDS" bluetoothctl --timeout "$SCAN_SECONDS" scan on >/dev/null 2>&1 &
        local scan_pid=$! i m seen
        for ((i = 0; i < SCAN_SECONDS; i++)); do
            seen="$(bluetoothctl devices 2>/dev/null)"
            for m in "${remaining[@]}"; do
                if grep -qi -- "$m" <<<"$seen"; then
                    kill "$scan_pid" 2>/dev/null
                    bluetoothctl scan off >/dev/null 2>&1
                    echo "$m"
                    return 0
                fi
            done
            sleep 1
        done
        kill "$scan_pid" 2>/dev/null
        bluetoothctl scan off >/dev/null 2>&1
        return 1
    }

    # Pair, trust and connect one MAC.
    pair_trust_connect() {
        local mac="$1" attempt info

        # Like GNOME Settings: one bluetoothctl session with a live pairing
        # agent, and the device trusted BEFORE pairing, so the Chubby's button
        # (HID) service is authorised while the link is being set up.
        log "Trusting, pairing and connecting $mac (takes ~20s)"
        {
            echo "agent on"
            echo "trust $mac";   sleep 1
            echo "pair $mac";    sleep 10
            echo "connect $mac"; sleep 8
            echo "quit"
        } | bluetoothctl >/dev/null 2>&1

        info="$(bluetoothctl info "$mac" 2>/dev/null)"
        grep -q "Paired: yes"  <<<"$info" || { warn "Pairing failed"; return 1; }
        grep -q "Trusted: yes" <<<"$info" || bluetoothctl trust "$mac" >/dev/null

        # Connect (retry if needed), then make sure it stays connected.
        for attempt in 1 2 3; do
            if ! bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes"; then
                bluetoothctl connect "$mac" >/dev/null 2>&1
                sleep 3
            fi
            log "Checking the connection holds..."
            sleep 10
            if bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes"; then
                return 0
            fi
            warn "Connection dropped (attempt $attempt), reconnecting..."
        done
        return 1
    }

    # Remove one MAC from "remaining".
    drop_remaining() {
        local -a keep=() m
        for m in "${remaining[@]}"; do [[ "$m" == "$1" ]] || keep+=("$m"); done
        remaining=("${keep[@]}")
    }

    # --- 3. One device at a time --------------------------------------------
    local total=${#remaining[@]} n=0 found reply
    local -a connected=() failed=()
    trap 'bluetoothctl scan off >/dev/null 2>&1' EXIT

    while ((${#remaining[@]} > 0)); do
        n=$((n + 1))
        echo
        printf '\033[1;35m>>>\033[0m Turn on Chubby Buttons #%d of %d and put it in pairing mode, then press Enter (s = skip the rest): ' "$n" "$total"
        read -r reply </dev/tty
        [[ "$reply" == [sS]* ]] && break

        log "Scanning for up to ${SCAN_SECONDS}s for: ${remaining[*]}"
        if ! found="$(scan_for_any)"; then
            warn "None of the remaining devices showed up. Try again."
            n=$((n - 1))
            continue
        fi
        log "Found $found"
        drop_remaining "$found"

        if pair_trust_connect "$found"; then
            ok "Connected $found"
            connected+=("$found")
        else
            warn "Could not connect $found (try: bluetoothctl info $found)"
            failed+=("$found")
        fi
    done

    # --- 4. Summary ---------------------------------------------------------
    echo
    ((${#connected[@]})) && ok   "Connected:     ${connected[*]}"
    ((${#failed[@]}))    && warn "Failed:        ${failed[*]}"
    ((${#remaining[@]})) && warn "Not attempted: ${remaining[*]}"
    ((${#failed[@]} == 0 && ${#remaining[@]} == 0))
)